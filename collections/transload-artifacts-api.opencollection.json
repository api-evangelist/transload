{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pipeline Backend Admin Artifacts API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Artifacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /v1/artifacts/local/{resultId}/{artifactKind}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/artifacts/local/:resultId/:artifactKind",
            "params": [
              {
                "name": "resultId",
                "value": "",
                "type": "path"
              },
              {
                "name": "artifactKind",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}