            "url": "{{baseUrl}}/v1/scans/:id/stages/:stage/complete",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "stage",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
