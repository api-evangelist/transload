              },
              {
                "name": "stage",
                "value": "",
                "type": "query"
              },
              {
                "name": "stageStatus",
                "value": "",
                "type": "query"
              },
              {
                "name": "capturedAfter",
                "value": "",
                "type": "query"
              },
              {
                "name": "capturedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
