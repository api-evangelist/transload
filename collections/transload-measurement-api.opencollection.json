{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pipeline Backend Admin Measurement API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Measurement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "POST /v1/measurement/results",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/measurement/results",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}